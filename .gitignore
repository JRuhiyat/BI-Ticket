# Ignore temporary runtime files
/tmp/*
/log

/app/assets/builds/*
!/app/assets/builds/.keep

/node_modules

# Ignore Rails master key
/config/master.key

# Ignore local environment files
/.env
/.env.*

# Ignore credentials backup files
/config/credentials/*.key
/config/credentials/*.enc.backup

# Ignore local SQLite databases (user data)
/db/*.sqlite3
/db/*.sqlite3-wal
/db/*.sqlite3-shm

# Ignore local vendor binaries and gems
/vendor/ruby/
/vendor/bundle/