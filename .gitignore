config/database.yml
/tmp/*
/log

/app/assets/builds/*
!/app/assets/builds/.keep

/node_modules

# Ignore Rails master key
/config/master.key

# Ignore local environment files
/.env
/.env.*

# Ignore credentials backup files
/config/credentials/*.key
